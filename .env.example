# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security Secrets (Replace with random strings in production)
JWT_SECRET=aetheria_super_secure_jwt_secret_change_in_production_2026
SESSION_SECRET=aetheria_session_cookie_secret_key_998877

# Database Configuration (PostgreSQL / Embedded PGlite)
# If DATABASE_URL is unset, Aetheria automatically uses the embedded persistent PostgreSQL engine in ./data/pgdata
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aetheria_db
PGDATA_DIR=./data/pgdata

# Redis Configuration (Optional: automatically falls back to in-memory cache)
# REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Gemini AI API Key (Optional: rich fallback responses provided if unset)
GEMINI_API_KEY=

# File Upload Configuration
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes

